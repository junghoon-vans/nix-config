#!/usr/bin/env bash

set -euo pipefail

base_sha=${1:?usage: detect-nix-config-changes <base-sha> <head-sha>}
head_sha=${2:?usage: detect-nix-config-changes <base-sha> <head-sha>}

if git diff --quiet "$base_sha" "$head_sha" -- \
  .github/workflows/validate.yml \
  flake.nix \
  flake.lock \
  hosts \
  modules \
  home; then
  printf 'configuration_changed=false\n' >> "$GITHUB_OUTPUT"
else
  printf 'configuration_changed=true\n' >> "$GITHUB_OUTPUT"
fi
