#!/usr/bin/env bash

set -euo pipefail

base_sha=${1:?usage: detect-nix-config-changes <base-sha> <head-sha>}
head_sha=${2:?usage: detect-nix-config-changes <base-sha> <head-sha>}
base_sha=$(git merge-base "$base_sha" "$head_sha")

if ! git diff --quiet "$base_sha" "$head_sha" -- release-pins.json; then
  python3 -B scripts/validation/check-release-pins.py
fi

# Disable rename detection so both sides of moves must satisfy the allowlist.
# Unknown paths, mixed changes and empty diffs take the full validation path.
skills_only=false
changed_paths=$(mktemp)
trap 'rm -f "$changed_paths"' EXIT
git diff --name-only --no-renames -z "$base_sha" "$head_sha" > "$changed_paths"
if [ -s "$changed_paths" ]; then
  skills_only=true
  while IFS= read -r -d '' path; do
    case "$path" in
      apm.yml|apm.lock.yaml|docs/skills.md|skills/*) ;;
      *) skills_only=false; break ;;
    esac
  done < "$changed_paths"
fi

printf 'skills_only=%s\n' "$skills_only" >> "$GITHUB_OUTPUT"
if [ "$skills_only" = true ]; then
  printf 'configuration_changed=false\n' >> "$GITHUB_OUTPUT"
else
  printf 'configuration_changed=true\n' >> "$GITHUB_OUTPUT"
fi
