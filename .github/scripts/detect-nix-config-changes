#!/usr/bin/env bash

set -euo pipefail

base_sha=${1:?usage: detect-nix-config-changes <base-sha> <head-sha>}
head_sha=${2:?usage: detect-nix-config-changes <base-sha> <head-sha>}
base_sha=$(git merge-base "$base_sha" "$head_sha")

if ! git diff --quiet "$base_sha" "$head_sha" -- release-pins.json; then
  python3 -B scripts/validation/check-release-pins.py
fi

# Disable rename detection so both sides of moves must satisfy the allowlist.
# Unknown paths, mixed changes and empty diffs take the full validation path.
profile=
paseo_config_changed=false
changed_paths=$(mktemp)
trap 'rm -f "$changed_paths"' EXIT
git diff --name-only --no-renames -z "$base_sha" "$head_sha" > "$changed_paths"
while IFS= read -r -d '' path; do
  if [ "$path" = home/.paseo/config.json ]; then
    paseo_config_changed=true
  fi
  case "$path" in
    apm.yml|apm.lock.yaml|docs/skills.md|skills/*) path_profile=apm ;;
    docs/apps.md) path_profile=darwin ;; # Generated from evaluated Darwin packages.
    README.md|docs/*.md|home/.paseo/config.json) path_profile=static ;;
    *) path_profile=darwin ;;
  esac
  if [ -z "$profile" ]; then
    profile=$path_profile
  elif [ "$profile" != "$path_profile" ]; then
    profile=darwin
  fi
done < "$changed_paths"

printf 'profile=%s\n' "${profile:-darwin}" >> "$GITHUB_OUTPUT"
printf 'paseo_config_changed=%s\n' "$paseo_config_changed" >> "$GITHUB_OUTPUT"
