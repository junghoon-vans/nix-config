#!/usr/bin/env bash

set -euo pipefail

base_sha=${1:?usage: detect-nix-config-changes <base-sha> <head-sha>}
head_sha=${2:?usage: detect-nix-config-changes <base-sha> <head-sha>}
base_sha=$(git merge-base "$base_sha" "$head_sha")

if ! git diff --quiet "$base_sha" "$head_sha" -- release-pins.json; then
  python3 -B scripts/validation/check-release-pins.py
fi

if git diff --quiet "$base_sha" "$head_sha" -- \
  apm.yml \
  apm.lock.yaml \
  Makefile \
  flake.nix \
  flake.lock \
  hosts \
  modules \
  packages \
  home \
  scripts \
  ':(exclude)scripts/validation'; then
  printf 'configuration_changed=false\n' >> "$GITHUB_OUTPUT"
else
  printf 'configuration_changed=true\n' >> "$GITHUB_OUTPUT"
fi
