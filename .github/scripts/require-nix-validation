#!/usr/bin/env bash

set -euo pipefail

: "${CHANGES_RESULT:?CHANGES_RESULT must be set}"
: "${VALIDATION_PROFILE:?VALIDATION_PROFILE must be set}"
: "${APM_RESULT:?APM_RESULT must be set}"
: "${DARWIN_RESULT:?DARWIN_RESULT must be set}"

if [ "$CHANGES_RESULT" != "success" ]; then
  printf 'Change detection or pinned skill input validation failed: changes=%s\n' "$CHANGES_RESULT" >&2
  exit 1
fi

case "$VALIDATION_PROFILE" in
  static)
    printf 'Ubuntu static validation passed; macOS validation not required.\n'
    ;;
  apm)
    if [ "$APM_RESULT" != success ]; then
      printf 'APM validation failed: apm=%s\n' "$APM_RESULT" >&2
      exit 1
    fi
    printf 'Skills-only APM validation passed.\n'
    ;;
  darwin)
    if [ "$DARWIN_RESULT" != success ]; then
      printf 'Nix configuration validation failed: darwin=%s\n' "$DARWIN_RESULT" >&2
      exit 1
    fi
    printf 'Nix configuration validation passed.\n'
    ;;
  *)
    printf 'Invalid change classification.\n' >&2
    exit 1
    ;;
esac
